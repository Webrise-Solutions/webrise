# ============================================================
# Webrise — environment variables
# Copy to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
# `.env` is gitignored. Never commit real values.
#
# Run `bun run check:env` to see what is missing and which optional features
# are currently on. It prints names only, never values.
#
# Everything under "Server-side only" must also be set in your host (Vercel →
# Settings → Environment Variables). A local .env is not deployed.
# ============================================================

# --- Client-side (inlined into the browser bundle at build time) ------------
# Safe to expose publicly. The publishable/anon key respects Row Level Security.

# Canonical origin, used for canonical URLs, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://webrise.co.uk

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings → API Keys → publishable (new format: sb_publishable_...)
# Legacy projects show this as the "anon / public" key (a long JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# The ref from your project URL, e.g. abcdefghijklmnop
NEXT_PUBLIC_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- Server-side only (never sent to the browser) ---------------------------

# Same URL as above, read by the admin client in Server Actions.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# REQUIRED for the audit form to save. Project Settings → API Keys → secret
# (new format: sb_secret_...) or the legacy "service_role" JWT.
# SECURITY: this key BYPASSES Row Level Security. Server-side only, never
# prefix it with NEXT_PUBLIC_, never paste it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# Declared in src/types/env.d.ts and used by tooling/scripts; not read by the
# app at runtime today. Safe to leave as-is.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- Lead notification email (SMTP, optional) -------------------------------
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD must ALL be set before anything sends.
# Without them every submission still saves; it just is not emailed, and each
# one logs a line saying so. Check it with `bun run check:smtp`.
#
# Gmail: port 587 (STARTTLS) or 465 (implicit TLS). Gmail does not listen on
# 585. SMTP_PASSWORD must be an app password from
# https://myaccount.google.com/apppasswords, which needs 2-Step Verification
# switched on; the plain account password is rejected. Free Gmail caps at
# roughly 500 recipients a day, which is ample for lead alerts but not for
# bulk sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Gmail rewrites From to the authenticated account, so this only sets the
# display name. Defaults to SMTP_USER when unset.
LEAD_NOTIFICATION_FROM=Webrise Leads <you@gmail.com>

# Where notifications land. Comma-separate for several. Defaults to SMTP_USER.
LEAD_NOTIFICATION_TO=you@gmail.com

# --- Form abuse controls (optional) ------------------------------------------
# Pepper for the hashed client address behind the per-IP rate limit. Falls back
# to SUPABASE_SERVICE_ROLE_KEY, so setting it only matters if you rotate that
# key and want existing hashes to keep matching. Use a different value per
# environment; generate one with `openssl rand -hex 32`.
FORM_HASH_SALT=

# --- Booking (optional) ------------------------------------------------------
# Cal.com / Calendly embed URL. With it set, /book-a-call shows the calendar;
# without it the page offers WhatsApp, email and phone instead.
NEXT_PUBLIC_BOOKING_URL=
